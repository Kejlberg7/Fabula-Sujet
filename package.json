{
  "name": "fabula-sujet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Story bible and manuscript workbench: what happened, when it is told, and who knew what.",
  "scripts": {
    "dev": "node --watch-path=./src --import tsx src/server/http.ts",
    "web": "vite",
    "build": "vite build",
    "start": "npm run build && node --import tsx src/server/http.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "node --import tsx --test src/test/*.test.ts",
    "mcp": "node --import tsx src/mcp/server.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "ask": "node --import tsx scripts/ask.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.13.5",
    "nanoid": "^5.0.9",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tiptap/core": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
