{
  "name": "fabula-sujet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Story bible and manuscript workbench: what happened, when it is told, and who knew what.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "node --import tsx --test src/test/*.test.ts",
    "mcp": "node --import tsx src/mcp/server.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "ask": "node --import tsx scripts/ask.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.4",
    "nanoid": "^5.0.9",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
